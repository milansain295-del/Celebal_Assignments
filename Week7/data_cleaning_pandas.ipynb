   "source": [
    "## Step 3 — Find and Fix Missing Values\n",
    "\n",
    "A quick scan with `isna().sum()` tells us where the gaps are. From there it's a judgment call per\n",
    "column: numeric columns like `Price` and `Quantity` get filled with the median (robust to outliers),\n",
    "while a categorical column like `Ship Mode` or `Region` gets filled with whatever value shows up\n",
    "most often."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "77314faf",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Ship Mode     9\n",
       "Region       15\n",
       "Price        12\n",
       "Quantity      9\n",
       "dtype: int64"
      ]
     },
     "execution_count": 10,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "missing_counts = sales.isna().sum()\n",
    "missing_counts[missing_counts > 0]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "bc6dd64b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filled Price with median: 286.46500000000003\n",
      "Filled Quantity with median: 5.0\n",
      "Filled Ship Mode with most common value: Same Day\n",
      "Filled Region with most common value: East\n"
     ]
    }
   ],
   "source": [
    "cleaned = sales.copy()\n",
    "\n",
    "price_median = cleaned['Price'].median()\n",
    "qty_median = cleaned['Quantity'].median()\n",
    "ship_mode_common = cleaned['Ship Mode'].mode()[0]\n",
    "region_common = cleaned['Region'].mode()[0]\n",
    "\n",
    "cleaned['Price'] = cleaned['Price'].fillna(price_median)\n",
    "cleaned['Quantity'] = cleaned['Quantity'].fillna(qty_median)\n",
    "cleaned['Ship Mode'] = cleaned['Ship Mode'].fillna(ship_mode_common)\n",
    "cleaned['Region'] = cleaned['Region'].fillna(region_common)\n",
    "\n",
    "print(f\"Filled Price with median: {price_median}\")\n",
    "print(f\"Filled Quantity with median: {qty_median}\")\n",
    "print(f\"Filled Ship Mode with most common value: {ship_mode_common}\")\n",
    "print(f\"Filled Region with most common value: {region_common}\")\n"
   ]
  },
